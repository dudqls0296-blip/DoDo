# 고민저장소 서버 설정 — 이 파일을 .env 로 복사해서 값을 넣으세요. (.env 는 git에 올리지 마세요)

# Google Gemini API 키 (Google AI Studio에서 발급). 고민 분석·답변·음악 3곡 추천에 쓰입니다.
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.7-flash

# YouTube Data API v3 키 (선택). 있으면 추천 영상의 공개·삽입 가능 여부를 재생 전에 다시 확인합니다.
YOUTUBE_API_KEY=

# PORT=8787

# (Vercel 배포용) 이 함수를 부를 수 있는 사이트 주소. 비워두면 GitHub Pages 주소와 localhost만 허용합니다.
# ALLOWED_ORIGINS=https://dudqls0296-blip.github.io
